{
  "servers": [
    {
      "id": "dbmcp",
      "name": "Haymon DB MCP",
      "transport": "stdio",
      "command": "/usr/bin/true",
      "args": [],
      "env": {},
      "enabled": false
    },
    {
      "id": "filesystem",
      "name": "Filesystem (npm)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/app/data"],
      "env": {},
      "enabled": false,
      "note": "Fails in this environment with Connection closed; local-filesystem is used instead."
    },
    {
      "id": "local-filesystem",
      "name": "Local Filesystem",
      "transport": "stdio",
      "command": "python3",
      "args": ["/home/workspace/Mcp/mcp-servers/filesystem.py"],
      "env": {},
      "enabled": false,
      "autoEnable": true,
      "note": "Local Python FastMCP server for /home/workspace. Auto-enables if python3 is available."
    },
    {
      "id": "local-fetch",
      "name": "Local Fetch",
      "transport": "stdio",
      "command": "python3",
      "args": ["/home/workspace/Mcp/mcp-servers/fetch.py"],
      "env": {},
      "enabled": false,
      "autoEnable": true,
      "note": "Local Python FastMCP server for HTTP GET/POST. Auto-enables if python3 is available."
    },
    {
      "id": "local-memory",
      "name": "Local Memory",
      "transport": "stdio",
      "command": "python3",
      "args": ["/home/workspace/Mcp/mcp-servers/memory.py"],
      "env": {},
      "enabled": false,
      "autoEnable": true,
      "note": "Local Python FastMCP key-value memory backed by Sage72 uploads/memory.json."
    },
    {
      "id": "local-shell",
      "name": "Local Shell",
      "transport": "stdio",
      "command": "python3",
      "args": ["/home/workspace/Mcp/mcp-servers/shell.py"],
      "env": {},
      "enabled": false,
      "note": "Local Python FastMCP shell execution. Disabled by default for safety; enable manually if needed."
    },
    {
      "id": "github",
      "name": "GitHub",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": true
    },
    {
      "id": "sequential-thinking",
      "name": "Sequential Thinking",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
      "enabled": true
    },
    {
      "id": "owlex",
      "name": "Owlex",
      "transport": "stdio",
      "command": "/usr/bin/true",
      "args": [],
      "env": {},
      "enabled": false
    },
    {
      "id": "magic-mcp",
      "name": "Magic MCP (Coding Lab)",
      "transport": "stdio",
      "command": "/usr/bin/true",
      "args": [],
      "env": {},
      "enabled": false
    },
    {
      "id": "ollama",
      "name": "Ollama",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "ollama-mcp"],
      "env": {
        "OLLAMA_HOST": "http://127.0.0.1:11434"
      },
      "enabled": true
    },
    {
      "id": "openrouter-mcp",
      "name": "OpenRouter MCP",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@stabgan/openrouter-mcp-multimodal"],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
      },
      "enabled": true
    },
    {
      "id": "serena",
      "name": "Serena",
      "transport": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena-mcp-server", "--context", "ide-assistant"],
      "env": {},
      "enabled": false,
      "autoEnable": true,
      "note": "Serena is a Python MCP server; the npm package @modelcontextprotocol/server-serena does not exist. Auto-enables at runtime if uvx is on PATH."
    },
    {
      "id": "memory",
      "name": "Project Memory",
      "transport": "stdio",
      "command": "/usr/bin/true",
      "args": [],
      "env": {},
      "enabled": false
    }
  ]
}
