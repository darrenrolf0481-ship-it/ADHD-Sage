{
  "servers": [
    {
      "id": "spiral-vault",
      "name": "Spiral Vault",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tsx",
        "${SPIRAL_VAULT_PATH}"
      ],
      "env": {},
      "enabled": true,
      "note": "Hermes-Spiral SQLite FTS5 Cold Memory Vault (~/.hermes/vault.db)",
      "autoEnable": true
    },
    {
      "id": "neural-memory",
      "name": "Neural Memory Brain",
      "transport": "stdio",
      "command": "/root/.venv/bin/python",
      "args": [
        "-m",
        "neural_memory.mcp"
      ],
      "env": {},
      "enabled": true,
      "note": "Spreading activation neuro-cognitive graph memory with causal chains",
      "autoEnable": true
    },
    {
      "id": "notebooklm",
      "name": "NotebookLM Research",
      "transport": "stdio",
      "command": "/root/.local/bin/notebooklm-mcp",
      "args": [],
      "env": {
        "NOTEBOOKLM_SERVER_TOKEN_FILE": "/root/.notebooklm/server-token.txt"
      },
      "enabled": true,
      "note": "Google NotebookLM research and artifact queries",
      "autoEnable": true
    },
    {
      "id": "memory",
      "name": "Persistent Knowledge Graph",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {},
      "enabled": true,
      "note": "Persistent semantic graph memory for entities and relations",
      "autoEnable": true
    },
    {
      "id": "sequential-thinking",
      "name": "Sequential Thinking",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "enabled": true,
      "note": "Dynamic multi-step reasoning and hypothesis verification",
      "autoEnable": true
    },
    {
      "id": "diffctx",
      "name": "DiffCtx Codebase Analyzer",
      "transport": "stdio",
      "command": "diffctx",
      "args": [
        "--mcp"
      ],
      "env": {},
      "enabled": false,
      "note": "AST and import-graph codebase intelligence engine",
      "autoEnable": true
    },
    {
      "id": "git-context",
      "name": "Git Context Forensics",
      "transport": "stdio",
      "command": "git-context-mcp",
      "args": [],
      "env": {},
      "enabled": false,
      "note": "Git commit forensics, blame tracking, and commit story narratives",
      "autoEnable": true
    },
    {
      "id": "large-file",
      "name": "Large File Inspector",
      "transport": "stdio",
      "command": "large-file-mcp",
      "args": [],
      "env": {},
      "enabled": false,
      "note": "Token-safe inspector for gigabyte-scale logs and transcripts",
      "autoEnable": true
    },
    {
      "id": "safe-docx",
      "name": "Safe DOCX Editor",
      "transport": "stdio",
      "command": "safe-docx",
      "args": [],
      "env": {},
      "enabled": false,
      "note": "Word document editing, comments, and inspection",
      "autoEnable": true
    },
    {
      "id": "md-to-pdf",
      "name": "Markdown To PDF",
      "transport": "stdio",
      "command": "md-to-pdf-mcp",
      "args": [],
      "env": {},
      "enabled": false,
      "note": "Publication-grade PDF renderer for reports",
      "autoEnable": true
    },
    {
      "id": "trinity-bridge",
      "name": "Trinity Bridge",
      "transport": "stdio",
      "command": "trinity-lite",
      "args": [],
      "env": {},
      "enabled": false,
      "note": "Multi-agent coordination and message broadcast",
      "autoEnable": true
    },
    {
      "id": "context7",
      "name": "Context7 Documentation",
      "transport": "stdio",
      "command": "context7-mcp",
      "args": [],
      "env": {},
      "enabled": false,
      "note": "Real-time vector documentation search for libraries and frameworks",
      "autoEnable": true
    }
  ]
}
