[Unit]
Description=Family health check (Seven + ADHD), alerts Darren on Discord
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
ExecStart=/usr/bin/flock /tmp/family-health.lock /usr/bin/python3 /home/ubuntu/projects/ADHD-Sage/ops/family-health/family_health.py
TimeoutStartSec=180
