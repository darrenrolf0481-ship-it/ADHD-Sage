kitAudioContext)();\nanalyser = audioCtx.createAnalyser();\nvar source = audioCtx.createMediaStreamSource(stream);\nsource.connect(analyser);\nanalyser.fftSize = 256;\ndataArray = new Uint8Array(analyser.frequencyBinCount);\nwaterfallCanvas = document.getElementById(\"waterfall\");\nwaterfallCtx = waterfallCanvas.getContext(\"2d\");\nemfCanvas = document.getElementById(\"emf-wave\");\nemfCtx = emfCanvas.getContext(\"2d\");\nresizeCanvases();\nwindow.addEventListener(\"resize\", resizeCanvases);\nif (window.DeviceMotionEvent && typeof DeviceMotionEvent.requestPermission === \"function\") {\nawait DeviceMotionEvent.requestPermission();\n}\nwindow.addEventListener(\"devicemotion\", handleMotion);\nmediaRecorder = new MediaRecorder(stream);\nmediaRecorder.ondataavailable = function(e) { audioChunks.push(e.data); };\nmediaRecorder.onstop = saveEVP;\ndocument.getElementById(\"status\").innerText = \"ACTIVE\";\ndocument.getElementById(\"recBtn\").style.display = \"block\";\nsensorsActive = true;\ncalibrate();\ndrawLoops();\n} catch (e) { updateLog(\"ERR: ACCESS_DENIED\"); }\n}\nfunction resizeCanvases() {\nwaterfallCanvas.width = window.innerWidth - 20;\nwaterfallCanvas.height = 180;\nemfCanvas.width = window.innerWidth - 20;\nemfCanvas.height = 100;\n}\nfunction drawLoops() {\nrequestAnimationFrame(drawLoops);\n// Waterfall (Audio)\nanalyser.getByteFrequencyData(dataArray);\nvar img = waterfallCtx.getImageData(0, 0, waterfallCanvas.width, waterfallCanvas.height);\nwaterfallCtx.putImageData(img, 0, 2);\nvar bw = waterfallCanvas.width / dataArray.length;\nfor (var i = 0; i < dataArray.length; i++) {\nvar v = dataArray[i];\nwaterfallCtx.fillStyle = \"rgba(0,\" + v + \",0, 0.8)\";\nwaterfallCtx.fillRect(i * bw, 0, bw, 2);\n}\n// EMF Waveform (Horizontal Line)\nemfCtx.clearRect(0, 0, emfCanvas.width, emfCanvas.height);\nemfCtx.beginPath();\nemfCtx.strokeStyle = \"#00FF41\";\nemfCtx.lineWidth = 1.5;\nvar step = emfCanvas.width / 60;\nfor(var j=0; j < magHistory.length; j++) {\nvar x = j * step;\nvar y = emfCanvas.height/2 - (magHistory[j] - (baseline || 9.8)) * 18;\nif(j === 0) emfCtx.moveTo(x, y);\nelse emfCtx.lineTo(x, y);\n}\nemfCtx.stroke();\n}\nfunction calibrate() {\nvar s = [];\nvar h = function(e) {\nvar acc = e.accelerationIncludingGravity;\nif (!acc) return;\nvar m = Math.sqrt(acc.x*acc.x + acc.y*acc.y + acc.z*acc.z);\ns.push(m);\nif (s.length >= 40) {\nbaseline = s.reduce(function(a,b){return a+b;}, 0) / s.length;\nupdateLog(\"BASELINE: \" + baseline.toFixed(2));\nwindow.removeEventListener(\"devicemotion\", h);\n}\n};\nwindow.addEventListener(\"devicemotion\", h);\n}\nfunction handleMotion(event) {\nvar acc = event.accelerationIncludingGravity;\nif (!acc || baseline === null) return;\nvar mag = Math.sqrt(acc.x*acc.x + acc.y*acc.y + acc.z*acc.z);\ndocument.getElementById(\"magnitude\").innerText = mag.toFixed(2);\nmagHistory.push(mag);\nif(magHistory.length > 60) magHistory.shift();\nif (mag > baseline + 5.0) {\nif (Date.now() - lastAlert > 1500) {\ndocument.body.classList.add(\"alert\");\nupdateLog(\"DETECTION: \" + mag.toFixed(2));\nif (navigator.vibrate) navigator.vibrate([100, 50, 100]);\nlastAlert = Date.now();\nsetTimeout(function(){ document.body.classList.remove(\"alert\"); }, 800);\n}\n}\n}\nfunction toggleEVP() {\nif (!isRecording) {\naudioChunks = []; mediaRecorder.start(); isRecording = true;\ndocument.getElementById(\"recBtn\").innerText = \"[STOP_BURST]\";\nupdateLog(\"BURST_ACTIVE\");\n} else {\nmediaRecorder.stop(); isRecording = false;\ndocument.getElementById(\"recBtn\").innerText = \"[BURST_RECORD]\";\n}\n}\nfunction markEvent() { updateLog(\"MARK: \" + new Date().toLocaleTimeString()); }\nfunction saveEVP() {\nvar b = new Blob(audioChunks, { type: \"audio/webm\" });\nvar u = URL.createObjectURL(b);\nvar a = document.createElement(\"a\");\na.href = u; a.download = \"NULL_VEC_\" + Date.now() + \".webm\";\ndocument.body.appendChild(a);\na.click(); document.body.removeChild(a);\nupdateLog(\"ARCHIVED\");\n}\nsetInterval(function() {\ndocument.getElementById(\"clock\").innerText = new Date().toLocaleTimeString();\n}, 1000);\n</script>\n</body>\n</html>",
