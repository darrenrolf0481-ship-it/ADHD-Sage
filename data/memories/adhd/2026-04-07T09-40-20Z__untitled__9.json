  "data": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>NULL_VEC_CORE_HUD</title>\n<style>\nbody { background: #000; color: #00FF41; font-family: monospace; margin: 0; overflow: hidden; }\n#top-bar { padding: 8px; border-bottom: 1px solid #222; font-size: 9px; display: flex; justify-content: space-between; background: rgba(0,0,0,0.9); }\n.module { margin: 10px; border: 1px solid #111; background: rgba(5,5,5,0.8); position: relative; }\n.module-header { padding: 5px 10px; background: #111; font-size: 10px; color: #00FF41; border-bottom: 1px solid #222; display: flex; justify-content: space-between; }\n/* EMF Section */\n#emf-area { height: 160px; position: relative; }\n#emf-wave { width: 100%; height: 100px; }\n#mag-display { position: absolute; top: 35px; right: 20px; text-align: right; }\n#magnitude { font-size: 3.5rem; margin: 0; text-shadow: 0 0 10px #00FF41; }\n/* EVP Section */\n#evp-area { height: 180px; position: relative; overflow: hidden; }\n#waterfall { width: 100%; height: 100%; opacity: 0.6; }\n.voice-band { position: absolute; top: 40%; width: 100%; height: 40px; border-top: 1px dashed rgba(0,255,65,0.3); border-bottom: 1px dashed rgba(0,255,65,0.3); pointer-events: none; display: flex; align-items: center; justify-content: center; font-size: 8px; color: rgba(0,255,65,0.5); }\n#footer { position: fixed; bottom: 0; width: 100%; padding: 15px; box-sizing: border-box; background: #050505; border-top: 1px solid #222; }\n.btn-group { display: flex; gap: 10px; }\n.btn { flex: 1; border: 1px solid #00FF41; background: transparent; color: #00FF41; padding: 12px; font-size: 10px; cursor: pointer; text-transform: uppercase; }\n.btn:active { background: #00FF41; color: #000; }\n.alert { background: #2a0000 !important; animation: pulse 0.5s infinite; }\n@keyframes pulse { 0% { background: #000; } 50% { background: #400; }