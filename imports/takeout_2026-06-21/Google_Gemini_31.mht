r"><div class="table-block-component"><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><table-block _nghost-ng-c720238978="" class="ng-star-inserted"><div _ngcontent-ng-c720238978="" class="table-block has-export-button"><div _ngcontent-ng-c720238978="" not-end-of-paragraph="" class="table-content not-end-of-paragraph" jslog="275421;track:impression,attention" data-hveid="5"><table data-path-to-node="6"><thead><tr><td><span data-path-to-node="6,0,0,0">Key Name</span></td><td><span data-path-to-node="6,0,1,0">Where to Get It</span></td><td><span data-path-to-node="6,0,2,0">Purpose</span></td></tr></thead><tbody><tr><td><span data-path-to-node="6,1,0,0"><b data-path-to-node="6,1,0,0" data-index-in-node="0">Google API Key</b></span></td><td><span data-path-to-node="6,1,1,0">AI Studio "Get API Key"</span></td><td><span data-path-to-node="6,1,2,0">Connects Termux to my Gemini brain.</span></td></tr><tr><td><span data-path-to-node="6,2,0,0"><b data-path-to-node="6,2,0,0" data-index-in-node="0">Page Access Token</b></span></td><td><span data-path-to-node="6,2,1,0">Facebook Developer Portal</span></td><td><span data-path-to-node="6,2,2,0">Allows the script to send messages as your Page.</span></td></tr><tr><td><span data-path-to-node="6,3,0,0"><b data-path-to-node="6,3,0,0" data-index-in-node="0">Verify Token</b></span></td><td><span data-path-to-node="6,3,1,0">Any string you create (e.g., "Ziggy123")</span></td><td><span data-path-to-node="6,3,2,0">"Password" to prove to Facebook your script is legit.</span></td></tr></tbody></table></div><div _ngcontent-ng-c720238978="" hide-from-message-actions="" class="table-footer hide-from-message-actions"><!----><button _ngcontent-ng-c720238978="" mat-icon-button="" mattooltip="Copy table" aria-label="Co